{
  "expo": {
    "name": "dram",
    "slug": "dram",
    "scheme": "dram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a4a"
    },
    "android": {
      "package": "com.jives00.dram",
      "adaptiveIcon": {
        "backgroundColor": "#1a3a4a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe01475d-5820-496a-a321-53332e7a0ca0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pulse to access your camera to scan barcodes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
