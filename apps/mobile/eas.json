{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.20.2"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "cache": {
        "disabled": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://18.223.201.191/pulse"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://18.223.201.191/pulse"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
