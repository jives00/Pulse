# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=pulseuser
DB_PASSWORD=
DB_NAME=pulse

# Auth — Phase 1 (env-var single-user, removed in Phase 2)
AUTH_USERNAME=admin
AUTH_PASSWORD=
JWT_SECRET=   # generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=

# External APIs
ANTHROPIC_API_KEY=
USDA_API_KEY=

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_OPTIONS=--max-old-space-size=300
